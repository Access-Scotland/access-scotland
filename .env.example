RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Access Scotland <contact@accessscotland.com>"
CONTACT_RECIPIENT_EMAILS=jonathan@accessscotland.com,tony@accessscotland.com

# Turnstile can stay optional locally, but should be required in production.
VITE_TURNSTILE_SITE_KEY=0x4AAAAA_your_site_key
TURNSTILE_SECRET_KEY=0x4AAAAA_your_secret_key
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_EXPECTED_HOSTNAMES=accessscotland.com,www.accessscotland.com,your-site.netlify.app
CONTACT_TURNSTILE_REQUIRED=false

# Optional durable rate limiting. Without Upstash, functions use in-memory limits.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

CONTACT_REQUEST_IP_MAX=20
CONTACT_REQUEST_IP_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_IP_MAX=3
CONTACT_RATE_LIMIT_IP_WINDOW_SECONDS=3600
CONTACT_RATE_LIMIT_EMAIL_MAX=2
CONTACT_RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
CONTACT_RATE_LIMIT_GLOBAL_MAX=50
CONTACT_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400
CONTACT_DUPLICATE_WINDOW_SECONDS=86400
CONTACT_MAX_MESSAGE_LENGTH=3000
CONTACT_MAX_URLS=2
